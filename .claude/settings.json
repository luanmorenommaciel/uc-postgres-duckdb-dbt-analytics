{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(uv run:*)",
      "Bash(uv sync)",
      "Bash(ruff check:*)",
      "Bash(pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./src/**)",
      "Read(./docs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(docker compose down -v)",
      "Bash(make clean)",
      "Bash(make reset)"
    ]
  }
}
